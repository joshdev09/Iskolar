{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": ["server/**/*", "frontend/src/types/**/*"],
  "exclude": ["node_modules", "dist"]
}